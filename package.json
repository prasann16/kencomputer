{
  "name": "ken-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A little help. A lot more headspace. Ken for your desktop.",
  "author": "Prasann",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "pack": "electron-builder --dir -c.mac.identity=- -c.mac.notarize=false",
    "dist:mac": "electron-builder --mac",
    "build:engine": ".venv/bin/python desktop/build_engine.py"
  },
  "devDependencies": {
    "chrome-devtools-mcp": "1.10.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.kencomputer.desktop",
    "productName": "Ken",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/loading.html",
      "desktop/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ken uses your microphone when you choose to dictate a message."
      },
      "hardenedRuntime": true,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Ken-${arch}.${ext}"
    },
    "icon": "desktop/icon.png",
    "extraResources": [
      {
        "from": "dist/engine-${arch}/ken-engine",
        "to": "engine"
      },
      {
        "from": "node_modules/chrome-devtools-mcp",
        "to": "browser/chrome-devtools-mcp",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "prasann16",
      "repo": "kencomputer",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
