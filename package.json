{
  "name": "ken-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A little help. A lot more headspace. Ken for your desktop.",
  "author": "Prasann",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "build:engine": ".venv/bin/python desktop/build_engine.py"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.kencomputer.desktop",
    "productName": "Ken",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/loading.html",
      "desktop/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ken uses your microphone when you choose to dictate a message."
      },
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist"
    },
    "icon": "desktop/icon.png",
    "extraResources": [
      {
        "from": "dist/engine/ken-engine",
        "to": "engine"
      }
    ]
  }
}
