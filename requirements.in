# The parts Ken is built from. requirements.txt is the locked, exact version of this list:
#   uv pip compile requirements.in --universal --python-version 3.10 --no-header -o requirements.txt
# (add --upgrade to move to the newest versions; the weekly update does that)
python-telegram-bot>=22.8
python-dotenv>=1.2
httpx>=0.28
faster-whisper>=1.2.1
# av 19 dropped the metadata_errors option faster-whisper 1.2.1 passes; voice notes fail on it.
av>=15,<19
# Claude Code ships inside the SDK; new models need a recent one.
claude-agent-sdk>=0.2.163
aiohttp>=3.14
# Newer onnxruntime (a faster-whisper dependency) ships no Intel Mac build.
onnxruntime<1.24 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
# cryptography 49+ ships no Intel Mac build; compiling it there needs Rust and a matching OpenSSL
# (the v0.1.0 Intel chat failure). 48.x has a ready-made build with OpenSSL inside.
cryptography<49 ; sys_platform == 'darwin' and platform_machine == 'x86_64'
